# =============================================================================
# Cyvera / AutoPentest AI — Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # Then edit .env with your real values
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
PROJECT_NAME="Cyvera"
ENVIRONMENT="development"   # "development" | "production"


# -----------------------------------------------------------------------------
# JWT Secret Key (REQUIRED)
# -----------------------------------------------------------------------------
# SECURITY: Must be set in both development and production. The application
# will refuse to start if this value is missing or matches any known placeholder.
#
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_hex(48))"
#
# Example output (do NOT use this exact value):
#   JWT_SECRET_KEY="a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8e7d6c5b4a3f2"
#
# Note: SECRET_KEY is also accepted as an alias for backwards compatibility.
JWT_SECRET_KEY="REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY"

ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Development (SQLite — no setup required):
DATABASE_URL="sqlite+aiosqlite:///./autopentest.db"

# Production (PostgreSQL — recommended):
# DATABASE_URL="postgresql+asyncpg://user:password@host:5432/autopentest_db"


# -----------------------------------------------------------------------------
# CORS — Allowed Frontend Origins
# -----------------------------------------------------------------------------
# Add your production frontend URL to this list when deploying.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]


# -----------------------------------------------------------------------------
# AI Integration — Google Gemini (Optional)
# -----------------------------------------------------------------------------
# Provide your Gemini API key to enable live AI vulnerability analysis and the
# Security Copilot chat.  When this value is empty or not set, the application
# automatically falls back to the built-in expert rule engine — all features
# remain functional without this key.
#
# Obtain a key at: https://aistudio.google.com/app/apikey
#
GEMINI_API_KEY=""


# -----------------------------------------------------------------------------
# Private Application Access Control
# -----------------------------------------------------------------------------
# In production, public registration is disabled by default (false).
# To allow administrative bootstrap of new accounts, set ADMIN_BOOTSTRAP_TOKEN.
ALLOW_PUBLIC_REGISTRATION=false
ADMIN_BOOTSTRAP_TOKEN=""


# -----------------------------------------------------------------------------
# Fixed Operator Account Configuration
# -----------------------------------------------------------------------------
# Single fixed operator credentials used to bootstrap / synchronize the
# administrative account on startup.
OPERATOR_USERNAME="Yash"
OPERATOR_EMAIL="operator@cyvera.io"
OPERATOR_PASSWORD="Choose-A-Strong-Password"

